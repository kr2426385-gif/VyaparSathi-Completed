# VyaparSathi Environment Variables

# 1. Google Maps JavaScript API Key
# Required APIs to enable on Google Cloud Console:
# - Maps JavaScript API
# - Places API
# - Geocoding API
# - Geolocation API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE


# 3. Firebase Web Configuration (vyaparsathi-otp)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=vyaparsathi-otp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vyaparsathi-otp
VITE_FIREBASE_STORAGE_BUCKET=vyaparsathi-otp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID_HERE

