# VyaparSathi Environment Variables Example Template
# Copy this file to .env and replace placeholders with real configurations.
# NEVER commit real credentials to version control.

# Backend Configuration
PORT=5000
JWT_SECRET=your_production_jwt_secret_key_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vyaparsathi?retryWrites=true&w=majority
AI_SERVICE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Learning Pipeline Minimum Sample Thresholds
ML_MIN_REAL_SAMPLES_PROFIT=100
ML_MIN_REAL_SAMPLES_DEMAND=100
ML_MIN_REAL_SAMPLES_CATEGORY=100
ML_MIN_REAL_SAMPLES_SUITABILITY=1000
ML_AUTO_RETRAIN_ENABLED=false

# External Third-Party APIs (Server-Side Only - Never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MANDI_API_KEY=your_mandi_api_key_here
MANDI_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MARKET_DATA_PROVIDER=mandi # Options: mandi, external, unavailable
COMPETITOR_DATA_PROVIDER=overpass # Options: overpass, registry, local, unavailable
